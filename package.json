    "@langchain/langgraph-sdk": "^1.12.8",
    "@langchain/openai": "^1.8.0",
    "@supabase/supabase-js": "^2.117.2",
    "@xyflow/react": "^12.12.0",
    "deepagents": "^1.16.2",
    "langchain": "^1.6.0",
    "langsmith": "^0.10.13",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tar": "^7.5.22",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.32.1"
